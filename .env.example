APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# mysql | mariadb -> debe coincidir con el motor real del servidor.
# Con MariaDB usa 'mariadb': el driver 'mysql' rompe db:show y db:table.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comunitarios
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Mercado Pago (Checkout Pro) ───────────────────────────────────────────────
# sandbox | production. Controla si se envian datos reales del pagador a MP.
MP_ENV=sandbox
# TEST-... en sandbox | APP_USR-... en produccion. NUNCA se commitea con valor.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Clave secreta del webhook (Panel MP > Webhooks). Valida la cabecera x-signature.
MP_WEBHOOK_SECRET=
# URL publica que recibe las notificaciones. En local, usa ngrok.
MP_WEBHOOK_URL=
# true  -> sandbox_init_point (credenciales TEST- clasicas)
# false -> init_point (credenciales APP_USR- + usuarios de prueba). Regla dura 7.
MP_USE_SANDBOX_INIT_POINT=false
MP_CURRENCY=PEN
# Email de usuario de prueba de MP. Regla dura 8: en sandbox NUNCA el correo real.
MP_SANDBOX_PAYER_EMAIL=
# Regla dura 3: deben ser HTTPS para que MP acepte auto_return=approved.
MP_BACK_URL_SUCCESS=
MP_BACK_URL_FAILURE=
MP_BACK_URL_PENDING=
# Opcionales (tienen valor por defecto en config/mercadopago.php)
MP_STATEMENT_DESCRIPTOR=
MP_TIMEOUT=

# ── Donaciones ────────────────────────────────────────────────────────────────
# Zona horaria SOLO para mostrar y exportar. Todo se guarda en UTC.
APP_DISPLAY_TIMEZONE=America/Lima

DONACION_MIN_MP=5
DONACION_MIN_QR=10
DONACION_MAX=10000
# false -> solo el dinero confirmado suma al total publico (rendicion de cuentas)
DASHBOARD_INCLUDE_PENDING=false
# Meta de la campana en PEN. Vacio = sin meta definida todavia.
CAMPANA_META=
# Ruta publica de la imagen del QR estatico de Yape/Plin.
QR_YAPE_IMAGEN=
# Horas tras las que una donacion de MP sin confirmar se considera expirada.
DONACION_EXPIRACION_HORAS=24
