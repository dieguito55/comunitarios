# =============================================================================
# comunitarios.org — plantilla de .env para PRODUCCIÓN (cPanel)
#
# Copia este archivo al servidor como `.env`, rellena los huecos y ponle
# permisos 600. NO es el .env.example de desarrollo y no debe mezclarse con él.
#
# NUNCA subas este archivo ya relleno a git.
#
# Los huecos vacíos que hay que rellenar sí o sí están marcados con « ← ».
# =============================================================================

# ── Aplicación ───────────────────────────────────────────────────────────────
# Fijos salvo que cambie el dominio.
APP_NAME=Comunitarios
APP_ENV=production

# En true se filtra el stack trace completo —con credenciales— a cualquiera que
# provoque un error. Déjalo en false.
APP_DEBUG=false

APP_URL=https://comunitarios.org

# Se genera EN EL SERVIDOR con `php artisan key:generate --force`.   ← rellenar
# Nunca reutilices la clave local: cifra sesiones y datos.
APP_KEY=

APP_LOCALE=es

# Desde la fase 3B existe lang/es/validation.php, así que el fallback también es
# "es". Si algún mensaje apareciera como "validation.algo", falta esa clave en
# lang/es/validation.php.
APP_FALLBACK_LOCALE=es

# Se guarda en UTC y se convierte a America/Lima al mostrar y al exportar.
APP_TIMEZONE=UTC

# Zona horaria SOLO para mostrar y exportar; el almacenamiento sigue en UTC.
APP_DISPLAY_TIMEZONE=America/Lima

# El modo mantenimiento que activa `artisan down` en el despliegue. Con "file"
# funciona sin base de datos, que es justo lo que hace falta mientras migra.
APP_MAINTENANCE_DRIVER=file

# ── Base de datos ────────────────────────────────────────────────────────────
# Los tres valores salen de cPanel → MySQL® Databases, al crear la base y el
# usuario. cPanel antepone el prefijo de la cuenta: si tu usuario es "comuonal"
# y la base "comunitarios", DB_DATABASE es "comuonal_comunitarios".
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# utf8mb4 de verdad: sin esto un nombre con emoji o ciertos caracteres andinos
# rompe el INSERT de la donación.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Registro ─────────────────────────────────────────────────────────────────
# Con debug en producción el disco se llena en días y el hosting corta la cuenta.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Los canales payments y webhooks son diarios y guardan 90 días por su cuenta;
# esto es solo para el canal daily genérico.
LOG_DAILY_DAYS=14

# Los avisos de obsolescencia de Laravel no interesan en producción.
LOG_DEPRECATIONS_CHANNEL=null

# ── Sesión, caché y colas ────────────────────────────────────────────────────
# En hosting compartido no hay Redis ni worker permanente, así que sesión y
# caché van a la base (sus tablas ya existen) y las colas se procesan en línea.
SESSION_DRIVER=database
CACHE_STORE=database
CACHE_PREFIX=comunitarios_cache
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database

# Minutos de inactividad antes de cerrar la sesión de un administrador.
SESSION_LIFETIME=120

# Las tres siguientes son las que protegen la sesión del panel. El sitio es
# HTTPS entero, así que la cookie NO debe viajar nunca por HTTP.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Déjalo vacío para que la cookie valga solo para el dominio exacto. Ponerlo a
# ".comunitarios.org" la compartiría con todos los subdominios.
SESSION_DOMAIN=

# ── Almacenamiento ───────────────────────────────────────────────────────────
# "local" = storage/app/private, que NO es accesible por URL. Los comprobantes
# del canal QR dependen de esto: con "public" quedarían expuestos.
FILESYSTEM_DISK=local

# ── Correo ───────────────────────────────────────────────────────────────────
# ⚠️ Hoy el sistema NO ENVÍA ningún correo: no hay Mailable ni Notification.
# Aun así MAIL_FROM_ADDRESS sí se usa YA — es el correo de contacto que se pinta
# en la pantalla de resultado ("¿Algo no cuadra? Escríbenos a …"). Si lo dejas
# vacío, esa frase aparece sin dirección.
#
# Los datos SMTP salen de cPanel → Email Accounts → Connect Devices.
MAIL_MAILER=smtp
MAIL_HOST=mail.comunitarios.org
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hola@comunitarios.org
MAIL_FROM_NAME="${APP_NAME}"

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Credenciales de la cuenta REAL: panel de MP → Tus integraciones → la
# aplicación → Credenciales de producción. Empiezan por APP_USR-.   ← rellenar
MP_ENV=production
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Clave secreta del webhook. Solo se muestra al crear o regenerar el webhook en
# el panel; si se pierde hay que regenerarla y volver a copiarla aquí.
# ES DISTINTA por aplicación: la de sandbox NO vale en producción. ← rellenar
MP_WEBHOOK_SECRET=

# Esta misma URL se registra en el panel de MP → Webhooks, eventos de Pagos.
MP_WEBHOOK_URL=https://comunitarios.org/api/webhooks/mercadopago

MP_CURRENCY=PEN

# Las tres DEBEN ser HTTPS: con HTTP, Mercado Pago rechaza la preferencia con un
# 400 al pedirle auto_return (regla dura 3).
#
# El parámetro se llama `donacion`, no `estado`: es el que lee
# ResultadoDonacionController para pintar el mensaje provisional. Con otro
# nombre la pantalla sigue funcionando, pero arranca sin mensaje útil para
# quien tenga el JavaScript desactivado.
MP_BACK_URL_SUCCESS=https://comunitarios.org/donacion/resultado?donacion=exitosa
MP_BACK_URL_FAILURE=https://comunitarios.org/donacion/resultado?donacion=fallida
MP_BACK_URL_PENDING=https://comunitarios.org/donacion/resultado?donacion=pendiente

# En false con credenciales APP_USR-: mezclarlo produce "Algo salió mal" en el
# checkout (regla dura 7).
MP_USE_SANDBOX_INIT_POINT=false

# ⚠️ VACÍO EN PRODUCCIÓN (regla dura 8). Solo se rellena en sandbox, con el
# correo de un usuario de prueba de MP. Con una credencial APP_USR- este valor
# sustituiría el correo real del donante y el comprobante iría a un buzón falso.
MP_SANDBOX_PAYER_EMAIL=

# Lo que el donante ve en el extracto de su tarjeta. Máximo 22 caracteres.
# Si no lo reconoce, reclama el cargo al banco.
MP_STATEMENT_DESCRIPTOR=COMUNITARIOS

# Segundos de espera de las llamadas a la API de MP. Subirlo mucho hace que un
# MP lento bloquee al donante en la pantalla de pago.
MP_TIMEOUT=15

# Vigencia del enlace de pago. Distinto de DONACION_EXPIRACION_HORAS, que es la
# barrida interna de pendientes.
MP_PREFERENCIA_EXPIRA_HORAS=24

# ── Reglas de la campaña ─────────────────────────────────────────────────────
# Montos en PEN. Los confirma tesorería antes de lanzar.
DONACION_MIN_MP=5
DONACION_MIN_QR=10
DONACION_MAX=10000

# Horas que una donación puede quedarse en "pendiente" antes de que la barrida
# programada la dé por caducada. No es lo mismo que la vigencia del enlace.
DONACION_EXPIRACION_HORAS=24

# Meta global de recaudación de la campaña, en PEN.
# VACÍO = todavía no definida, y entonces la barra de progreso se OCULTA en vez
# de mostrar un 0 % o una cifra inventada. Lo rellena tesorería.   ← rellenar
CAMPANA_META=

# false = solo el dinero confirmado suma al total público. Es rendición de
# cuentas de una fundación: un total que baja porque un pago se rechazó genera
# desconfianza.
DASHBOARD_INCLUDE_PENDING=false

# QR estático de Yape/Plin, servido desde public/.
QR_YAPE_IMAGEN=/qr/qr.jpeg
